{
  "name": "xrawl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Xrawl — a desktop word-scraping companion. Browser-first perception engine packaged with WXT.",
  "scripts": {
    "dev": "node scripts/copy-ort-wasm.mjs && wxt",
    "dev:firefox": "node scripts/copy-ort-wasm.mjs && wxt -b firefox",
    "build": "node scripts/copy-ort-wasm.mjs && wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "verify": "npm run build && node test/verify.mjs",
    "verify:headless": "npm run build && xvfb-run -a node test/verify.mjs",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:wordfreq": "node scripts/build-word-frequency.mjs",
    "build:ort": "node scripts/copy-ort-wasm.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.8",
    "playwright-core": "^1.65.1",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1",
    "wxt": "^0.20.6"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "dexie": "^4.4.7"
  }
}
