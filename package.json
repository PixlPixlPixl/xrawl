{
  "name": "xrawl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Xrawl — a desktop word-scraping companion. Browser-first perception engine packaged with WXT.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "verify": "npm run build && node test/verify.mjs",
    "verify:headless": "npm run build && xvfb-run -a node test/verify.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "typescript": "^5.7.3",
    "wxt": "^0.20.6"
  }
}
